# Copy to .env, replace local-only credentials and set AUTH_SECRET (32+ random characters).
DATABASE_URL=postgresql://studio:studio_local_only@localhost:5432/studio?schema=public
REDIS_URL=redis://localhost:6379
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_MODE=development
DEV_AUTH_EMAIL=creator@example.test
DEV_AUTH_PASSWORD=
LANGUAGE_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local/assets

# Supported default: native Prisma 6 migration/query engines.
STUDIO_PRISMA_ENGINE=classic
