generator client {
  provider = "prisma-client-js"
  engineType = "library"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  EDITOR
  VIEWER
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  memberships ProjectMembership[]
  drafts CharacterDraft[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Project {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships ProjectMembership[]
  characters Character[]
  drafts CharacterDraft[]
  auditEvents AuditEvent[]
  scenes Scene[]
  generations Generation[]
}
model ProjectMembership {
  projectId String
  userId String
  role Role @default(VIEWER)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}
model Character {
  id String @id @default(cuid())
  projectId String
  name String
  currentVersionId String? @unique
  revision Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  drafts CharacterDraft[]
  versions CharacterVersion[] @relation("History")
  currentVersion CharacterVersion? @relation("Current", fields: [projectId, id, currentVersionId], references: [projectId, characterId, id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([projectId, id])
  @@unique([projectId, id, currentVersionId])
  @@index([projectId, archivedAt, createdAt])
}
model CharacterVersion {
  id String @id @default(cuid())
  projectId String
  characterId String
  versionNumber Int
  schemaVersion Int @default(1)
  name String
  displayName String
  age Int
  location String
  occupation String
  bio String
  snapshot Json
  createdBy String
  createdAt DateTime @default(now())
  character Character @relation("History", fields: [projectId, characterId], references: [projectId, id], onDelete: Restrict)
  canonicalFor Character? @relation("Current")
  sceneVersions SceneVersion[]
  generations Generation[]
  @@unique([characterId, versionNumber])
  @@unique([projectId, characterId, id])
  @@index([projectId, characterId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  projectId String
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@index([projectId, createdAt])
}

model CharacterDraft {
  id String @id @default(cuid())
  projectId String
  createdBy String
  characterId String?
  baseRevision Int?
  answers Json
  step Int @default(0)
  revision Int @default(1)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  author User @relation(fields:[createdBy],references:[id],onDelete:Cascade)
  character Character? @relation(fields:[projectId,characterId],references:[projectId,id],onDelete:Restrict)
  @@index([projectId,createdBy,completedAt,updatedAt])
}

model Scene {
 id String @id @default(cuid())
 projectId String
 title String
 revision Int @default(1)
 status String @default("draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 versions SceneVersion[]
 @@unique([projectId,id])
 @@index([projectId,updatedAt])
}
model SceneVersion {
 id String @id @default(cuid())
 projectId String
 sceneId String
 versionNumber Int
 characterId String
 characterVersionId String
 choices Json
 prompt Json
 createdBy String
 createdAt DateTime @default(now())
 scene Scene @relation(fields:[projectId,sceneId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
 characterVersion CharacterVersion @relation(fields:[projectId,characterId,characterVersionId],references:[projectId,characterId,id],onDelete:Restrict,onUpdate:NoAction)
 generations Generation[]
 @@unique([projectId,sceneId,id])
 @@unique([sceneId,versionNumber])
 @@index([projectId,characterId,characterVersionId])
}

model Generation {
 id String @id @default(cuid())
 projectId String
 createdBy String
 characterId String
 characterVersionId String
 sceneId String
 sceneVersionId String
 input Json
 requestHash String
 idempotencyKey String
 status String @default("queued")
 progress Int @default(0)
 cancelRequested Boolean @default(false)
 leaseToken String?
 leaseUntil DateTime?
 retryCount Int @default(0)
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 project Project @relation(fields:[projectId],references:[id],onDelete:Restrict,onUpdate:NoAction)
 characterVersion CharacterVersion @relation(fields:[projectId,characterId,characterVersionId],references:[projectId,characterId,id],onDelete:Restrict,onUpdate:NoAction)
 sceneVersion SceneVersion @relation(fields:[projectId,sceneId,sceneVersionId],references:[projectId,sceneId,id],onDelete:Restrict,onUpdate:NoAction)
 assets ImageAsset[]
 outbox GenerationOutbox?
 @@unique([projectId,idempotencyKey])
 @@unique([projectId,id])
 @@index([status,leaseUntil])
}
model GenerationOutbox {
 id String @id @default(cuid())
 generationId String @unique
 deliveredAt DateTime?
 generation Generation @relation(fields:[generationId],references:[id],onDelete:Cascade)
}
model ImageAsset {
 id String @id @default(cuid())
 projectId String
 generationId String
 index Int
 status String @default("pending")
 attempts Int @default(0)
 key String?
 checksum String?
 mimeType String?
 size Int?
 metadata Json
 review String @default("unreviewed")
 sourceAssetId String?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 generation Generation @relation(fields:[projectId,generationId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
 source ImageAsset? @relation("Sources",fields:[projectId,sourceAssetId],references:[projectId,id],onDelete:Restrict,onUpdate:NoAction)
 children ImageAsset[] @relation("Sources")
 @@unique([generationId,index])
 @@unique([projectId,id])
 @@index([projectId,createdAt])
}
