generator client {
  provider = "prisma-client-js"
  engineType = "library"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  EDITOR
  VIEWER
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  memberships ProjectMembership[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Project {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships ProjectMembership[]
  characters Character[]
  auditEvents AuditEvent[]
}
model ProjectMembership {
  projectId String
  userId String
  role Role @default(VIEWER)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}
model Character {
  id String @id @default(cuid())
  projectId String
  name String
  currentVersionId String? @unique
  revision Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions CharacterVersion[] @relation("History")
  currentVersion CharacterVersion? @relation("Current", fields: [projectId, id, currentVersionId], references: [projectId, characterId, id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([projectId, id])
  @@unique([projectId, id, currentVersionId])
  @@index([projectId, archivedAt, createdAt])
}
model CharacterVersion {
  id String @id @default(cuid())
  projectId String
  characterId String
  versionNumber Int
  schemaVersion Int @default(1)
  name String
  displayName String
  age Int
  location String
  occupation String
  bio String
  snapshot Json
  createdBy String
  createdAt DateTime @default(now())
  character Character @relation("History", fields: [projectId, characterId], references: [projectId, id], onDelete: Restrict)
  canonicalFor Character? @relation("Current")
  @@unique([characterId, versionNumber])
  @@unique([projectId, characterId, id])
  @@index([projectId, characterId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  projectId String
  actorId String
  action String
  resourceId String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@index([projectId, createdAt])
}
